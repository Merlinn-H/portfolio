---
import styles from "./SectionHead.module.css";
import HiddenBadge from "./HiddenBadge.astro";

/** Titre de section. Le sur-titre du CMS sert de nom accessible à la section, il n'est pas affiché. */
interface Props {
  title?: string;
  id: string;
  hiddenLabel?: string | null;
}
const { title, id, hiddenLabel } = Astro.props;
---

{(title || hiddenLabel) && (
  <header class={styles.head}>
    <HiddenBadge show={Boolean(hiddenLabel)} label={hiddenLabel ?? ""} />
    {title ? (
      <h2 id={`${id}-title`} class={`${styles.title} reveal`}>
        {title}
      </h2>
    ) : null}
  </header>
)}
