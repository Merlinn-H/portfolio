---
import { Picture } from "astro:assets";
import type { getSite } from "@/lib/content";
import { pick } from "@/lib/content";
import type { Dict, Locale } from "@/lib/i18n";
import styles from "./Hero.module.css";

type Site = Awaited<ReturnType<typeof getSite>>;

interface Props {
  site: Site;
  locale: Locale;
  t: Dict;
  /** La section Projets est-elle affichée ? (sinon pas de bouton vers elle) */
  hasProjects?: boolean;
  /** Structures (projets hors courts-métrages) listées dans la feuille de service. */
  companies?: { title: string; href: string }[];
}
const { site, locale, t, hasProjects = true, companies = [] } = Astro.props;
const [first, ...rest] = site.name.split(" ");
const portrait = site.portraitImg;
---

<section id="top" data-section="" class={styles.hero} aria-labelledby="hero-title">
  <h1 id="hero-title" class={styles.name}>
    {/* Un seul bloc de texte (pas deux <span> en display:block) : le navigateur le compte
        comme un seul élément, le plus grand de l'écran : LCP peint dès le premier rendu. */}
    {first}
    <br />
    {rest.join(" ")}
  </h1>
  {/* En-tête de feuille de service : bandeau, puis lignes libellé / valeur, comme sur un vrai tournage. */}
  <div class={styles.sheet}>
    <p class={styles.sheetHead} aria-hidden="true">
      <span>{t.callSheet}</span>
      <span>N° 489</span>
    </p>
    <dl class={styles.sheetRows}>
      <div>
        <dt>{t.sheetRole}</dt>
        <dd>{pick(site.role, locale)}</dd>
      </div>
      {companies.length > 0 && (
        <div>
          <dt>{t.sheetCompanies}</dt>
          <dd>
            {companies.map((c, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a class="link" href={c.href}>
                  {c.title}
                </a>
              </>
            ))}
          </dd>
        </div>
      )}
      {site.email && (
        <div>
          <dt>{t.sheetContact}</dt>
          <dd>
            <a class="link" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </dd>
        </div>
      )}
    </dl>
  </div>

  {portrait ? (
    <div class={styles.portrait}>
      <Picture
        src={portrait}
        alt={pick(site.portraitAlt, locale)}
        formats={["avif", "webp"]}
        widths={[384, 640, 960, 1280]}
        width={1280}
        sizes="(min-width: 64rem) 36vw, (min-width: 40rem) 33vw, 100vw"
        quality={75}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  ) : null}

  <div class={styles.tagline}>
    <p>{pick(site.tagline, locale)}</p>
    <p class={styles.actions}>
      {hasProjects && (
        <a href="#projects" class={styles.primary}>
          {t.ctaProjects}
        </a>
      )}
      <a href="#contact" class={styles.ghost}>
        {t.ctaContact}
      </a>
    </p>
  </div>
</section>
