---
import { pick, type getExperiences } from "@/lib/content";
import type { Dict, Locale } from "@/lib/i18n";
import HiddenBadge from "@/components/ui/HiddenBadge.astro";
import styles from "./Experience.module.css";

type Exp = Awaited<ReturnType<typeof getExperiences>>[number];

interface Props {
  items: Exp[];
  intro: string;
  locale: Locale;
  t: Dict;
  /** Structures qui ont aussi une page projet (nom → lien) : on y renvoie au lieu de répéter leur description. */
  projectLinks?: Record<string, string>;
}
const { items, intro, locale, t, projectLinks = {} } = Astro.props;
const key = (s: string) => s.toLowerCase().replace(/\s+/g, "");
const linkFor = (company: string) => projectLinks[key(company)];
import Arrow from "@/components/ui/Arrow.astro";
---

<div class={styles.wrap}>
  {intro ? <p class={`${styles.intro} reveal`}>{intro}</p> : null}
  {/* Liste d'équipe de feuille de service : bandeau d'en-tête (visuel), puis une ligne par poste. */}
  <div class={styles.sheet}>
    <p class={styles.head} aria-hidden="true">
      <span>{t.sheetPeriod}</span>
      <span>{t.sheetRole}</span>
      <span>{t.sheetProduction}</span>
      <span>{t.sheetPlace}</span>
    </p>
    <ol class={styles.list}>
      {items.map((x) => (
        <li class={`${styles.item} reveal`}>
          <p class={styles.period}>{pick(x.period, locale)}</p>
          <h3 class={styles.title}>
            {pick(x.title, locale)}
            <HiddenBadge show={x.status === "hidden"} label={t.hidden} />
          </h3>
          <p class={styles.company}>
            {linkFor(x.company) ? (
              <a href={linkFor(x.company)} class={`link ${styles.companyLink}`}>
                {x.company} <Arrow />
              </a>
            ) : (
              x.company
            )}
          </p>
          {x.location ? <p class={styles.place}>{x.location}</p> : null}
          {!linkFor(x.company) && pick(x.description, locale) ? (
            <p class={styles.desc}>{pick(x.description, locale)}</p>
          ) : null}
        </li>
      ))}
    </ol>
  </div>
</div>
