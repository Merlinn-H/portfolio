---
import type { Project } from "@/lib/content";
import { pick } from "@/lib/content";
import { href, type Dict, type Locale } from "@/lib/i18n";
import HiddenBadge from "@/components/ui/HiddenBadge.astro";
import styles from "./ProjectList.module.css";

/**
 * Deux niveaux : les structures (société, studio…) en grand, les courts-métrages en filmographie compacte.
 * Pas de grille de cartes.
 */
interface Props {
  projects: Project[];
  locale: Locale;
  t: Dict;
  headingLevel?: 2 | 3;
}
const { projects, locale, t, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as const;
const Sub = `h${headingLevel}` as const;
const Item = `h${(headingLevel + 1) as 3 | 4}` as const;
const features = projects.filter((p) => p.category !== "short");
const shorts = projects.filter((p) => p.category === "short");
import Arrow from "@/components/ui/Arrow.astro";
import YtThumb from "@/components/project/YtThumb.astro";
import { Image } from "astro:assets";
---

<div class={styles.wrap}>
  {features.length > 0 ? (
    <ul class={styles.features}>
      {features.map((p) => (
        <li class={`${styles.feature} reveal`}>
          <a href={href(locale, `/projets/${p.slug}`)} class={styles.featureLink}>
            <span class={`credits ${styles.kicker}`}>
              {pick(p.kicker, locale)}
              {p.year ? <span class={styles.year}> · {p.year}</span> : null}
              <HiddenBadge show={p.status === "hidden"} label={t.hidden} />
            </span>
            <H class={styles.featureTitle}>{p.title}</H>
            <span class={styles.featureSide}>
              {p.coverImg ? (
                <span class={`viewfinder ${styles.featureCover}`}>
                  <Image
                    src={p.coverImg}
                    alt=""
                    widths={[320, 480, 640]}
                    sizes="(min-width: 64rem) 22vw, 92vw"
                    class={styles.featureImg}
                  />
                </span>
              ) : null}
              {pick(p.role, locale) ? <span class={styles.role}>{pick(p.role, locale)}</span> : null}
              <span class={styles.summary}>{pick(p.summary, locale)}</span>
            </span>
            <span class={styles.arrow} aria-hidden="true">
              <Arrow />
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : null}

  {shorts.length > 0 ? (
    <div class={styles.filmography}>
      <Sub class={`credits ${styles.sub}`}>{t.shorts}</Sub>
      <ol class={styles.shorts}>
        {shorts.map((p) => (
          <li class="reveal">
            <a href={href(locale, `/projets/${p.slug}`)} class={styles.shortLink}>
              <span class={styles.shortThumb} aria-hidden="true">
                {p.coverImg ? (
                  <Image src={p.coverImg} alt="" widths={[160, 320]} sizes="10rem" class={styles.shortImg} />
                ) : p.youtubeId ? (
                  <YtThumb id={p.youtubeId} class={styles.shortImg} />
                ) : null}
              </span>
              <span class={styles.shortYear}>{p.year}</span>
              <Item class={styles.shortTitle}>
                {p.title}
                <HiddenBadge show={p.status === "hidden"} label={t.hidden} />
              </Item>
              <span class={styles.shortRole}>{pick(p.role, locale)}</span>
              <span class={styles.shortArrow} aria-hidden="true">
                <Arrow />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  ) : null}
</div>
