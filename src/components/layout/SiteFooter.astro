---
import type { Dict } from "@/lib/i18n";
import styles from "./SiteFooter.module.css";

interface Props {
  name: string;
  note: string;
  email?: string;
  socials: readonly { label: string; url: string | null }[];
  /** Métier, affiché comme une ligne de générique. */
  role?: string;
  t: Dict;
}
const { name, note, email, socials, role, t } = Astro.props;
import Arrow from "@/components/ui/Arrow.astro";
---

<footer class={styles.footer}>
  <!-- Carton de fin, comme au cinéma -->
  <p class={styles.end} aria-hidden="true">
    {t.end}
  </p>
  <div>
    <p class={styles.name}>{name}</p>
    {role && <p class={`credits ${styles.role}`}>{role}</p>}
  </div>
  <ul class={styles.links}>
    {email && (
      <li>
        <a class="link" href={`mailto:${email}`}>
          {email}
        </a>
      </li>
    )}
    {socials
      .filter((s) => s.url)
      .map((s) => (
        <li>
          <a class="link" href={s.url!} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        </li>
      ))}
    <li>
      <a class="link" href="#top">
        {t.backToTop} <Arrow dir="up" />
      </a>
    </li>
  </ul>
  <p class={styles.note}>
    © {new Date().getFullYear()} {note}
  </p>
</footer>
