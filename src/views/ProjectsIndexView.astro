---
import { getHome, getProjects, pick } from "@/lib/content";
import { ui, type Locale } from "@/lib/i18n";
import ProjectList from "@/components/sections/ProjectList.astro";
import styles from "./PageView.module.css";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const projects = await getProjects();
const section = (await getHome()).find((s) => s.type === "projects");
---

<div class={styles.page}>
  <header class={styles.head}>
    <p class={`credits ${styles.eyebrow}`}>{pick(section?.eyebrow, locale) || "Portfolio"}</p>
    <h1 class={styles.title}>{pick(section?.title, locale) || t.allProjects}</h1>
  </header>
  <ProjectList projects={projects} locale={locale} t={t} headingLevel={2} />
</div>
