---
import { ClientRouter } from "astro:transitions";
import { Font, getImage } from "astro:assets";
import "@/styles/globals.css";
import { getNavigation, getSite, img, pick } from "@/lib/content";
import { href, ui, type Locale } from "@/lib/i18n";
import type { Seo } from "@/lib/seo";
import SiteNav from "@/components/layout/SiteNav.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import Intro from "@/components/layout/Intro.astro";
import styles from "@/components/layout/RootShell.module.css";

interface Props {
  locale: Locale;
  seo: Seo;
  /** Chemin sans préfixe de langue (ex. "/projets/postmeridian"), pour la bascule FR/EN. */
  path: string;
  /** Données structurées propres à la page (en plus de la fiche « Person »). */
  jsonLd?: Record<string, unknown>[];
}

const { locale, seo, path, jsonLd = [] } = Astro.props;
const site = await getSite();
const nav = await getNavigation(locale);
const t = ui(locale);
const introLogo = site.introEnabled ? img(site.introLogo) : null;
const base = (site.url || "https://hugopezzo.fr").replace(/\/$/, "");
// Fiche « Person » : une version légère du portrait (800 px), pas le fichier source.
const personImage = site.portraitImg
  ? await getImage({ src: site.portraitImg, width: 800, format: "jpg", quality: 80 })
  : null;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: pick(site.role, locale),
  url: `${base}${href(locale, "/") === "/" ? "" : href(locale, "/")}`,
  image: personImage ? `${base}${personImage.src}` : undefined,
  email: site.email ? `mailto:${site.email}` : undefined,
  sameAs: site.socials.map((s) => s.url).filter(Boolean),
};
---

<!doctype html>
<html lang={locale} data-path={path}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0a09" />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {
      /* Mesure d'audience Vercel (sans cookie) : à activer dans /keystatic APRÈS l'avoir activée dans Vercel. */
      site.analytics === "vercel" && import.meta.env.PROD && (
        <script is:inline defer src="/_vercel/insights/script.js" data-astro-rerun={false} />
      )
    }
    <Font cssVariable="--font-open-sans" preload={[{ weight: 700, style: "normal" }]} />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {jsonLd.map((d) => (
      <script type="application/ld+json" set:html={JSON.stringify(d)} />
    ))}
  </head>
  <body>
    <a href="#content" class={styles.skip}>
      {t.skip}
    </a>
    {introLogo && <Intro logo={introLogo} label={site.introLogoAlt ?? ""} />}
    <SiteNav items={nav} locale={locale} t={t} name={site.name} path={path} />
    <main id="content" tabindex="-1" class={styles.main}>
      <slot />
    </main>
    <SiteFooter
      role={pick(site.role, locale)}
      name={site.name}
      note={pick(site.footer, locale)}
      email={site.email}
      socials={site.socials}
      t={t}
    />
  </body>
</html>
